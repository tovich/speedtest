# Только HTTP/1.1: по HTTP/2 и HTTP/3 браузер пускает все потоки теста через одно
# соединение, и скорость упирается в возможности одного TCP-потока.
{
	servers {
		protocols h1
	}
}

{$DOMAIN} {
	encode {
		gzip
		match {
			not path /api/*
		}
	}
	reverse_proxy speedtest:8080 {
		# без буферизации, иначе тест загрузки/отдачи измеряет прокси, а не канал
		flush_interval -1
		request_buffers 0
		response_buffers 0
	}
}
